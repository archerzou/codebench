{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },
  "Seeding": {
    "ProblemsPath": ""
  },
  "ConnectionStrings": {
    "Database": "",
    "Redis": "",
    "Nats": ""
  },
  "Clerk": {
    "Issuer": "",
    "AuthorizedParties": [],
    "WebhookSecret": "",
    "SecretKey": ""
  },
  "Admin": {
    "BootstrapEmails": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowInSeconds": 60
    },
    "Authentication": {
      "PermitLimit": 10,
      "WindowInSeconds": 60
    }
  }
}
