{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=15432;Database=codebench;Username=codebench;Password=codebench;Include Error Detail=true",
    "Redis": "localhost:16379",
    "Nats": "nats://localhost:4222"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.OpenTelemetry"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
            "service.name": "codebench-api"
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Clerk": {
    "Issuer": "https://immense-buzzard-7056.clerk.accounts.dev",
    "AuthorizedParties": [ "http://localhost:5173", "http://app.codebench.localhost" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4321", "http://app.codebench.localhost", "http://codebench.localhost" ]
  }
}
