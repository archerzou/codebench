<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Grading orchestrator. Pulls jobs from NATS, runs each in a throwaway sandbox container
    on the sandbox Docker daemon, publishes results back to NATS.
    MUST NOT reference the database stack or the API project (rule AR-02, enforced by
    ArchitectureTests/Layers/BoundaryTests and scripts/check-rules.ps1).
  -->
  <PropertyGroup>
    <AssemblyName>CodeBench.Worker</AssemblyName>
    <RootNamespace>CodeBench.Worker</RootNamespace>
    <UserSecretsId>codebench-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
  </ItemGroup>

</Project>
