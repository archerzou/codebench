---
/** Long-form pages written in MDX (how-it-works, legal). Frontmatter: title, description, optional updated. */
import BaseLayout from './BaseLayout.astro';

type Props = {
  frontmatter: { title: string; description: string; updated?: string };
};

const { title, description, updated } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="mb-8 max-w-[68ch]">
      <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
      <p class="mt-3 text-lg text-ink-muted">{description}</p>
      {updated && <p class="mt-2 text-sm text-ink-muted">Last updated <time datetime={updated}>{updated}</time></p>}
    </header>
    <div class="prose-cb">
      <slot />
    </div>
  </article>
</BaseLayout>
