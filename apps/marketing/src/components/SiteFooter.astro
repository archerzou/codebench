---
/** Site footer (pages.md): legal links, RSS, GitHub. */
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import rss from 'lucide-static/icons/rss.svg?raw';
import { config } from '../config';

const legal = [
  { href: '/legal/terms', label: 'Terms' },
  { href: '/legal/privacy', label: 'Privacy' },
  { href: '/legal/acceptable-use', label: 'Acceptable use' },
];
---

<footer class="mt-24 border-t border-line bg-surface-sunken">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 text-sm sm:flex-row sm:items-start sm:justify-between sm:px-6">
    <div class="flex flex-col gap-2">
      <Wordmark />
      <p class="max-w-xs text-ink-muted">C# practice graded on time, allocations, SQL and readability.</p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
      {legal.map((item) => <a href={item.href} class="text-ink-muted hover:text-ink hover:underline">{item.label}</a>)}
      <a href="/rss.xml" class="inline-flex items-center gap-1.5 text-ink-muted hover:text-ink hover:underline">
        <Icon svg={rss} class="size-3.5" />RSS
      </a>
      <a href={config.githubUrl} class="text-ink-muted hover:text-ink hover:underline" rel="noopener">GitHub</a>
    </nav>
  </div>
</footer>
