---
/** Mirrors apps/web DifficultyBadge: neutral badge, 1–3 filled pips + the word (difficulty isn't a status). */
import Badge from './Badge.astro';
import type { Difficulty } from '../lib/domain';

type Props = { difficulty: Difficulty; class?: string };
const { difficulty, class: className } = Astro.props;
const filled = { easy: 1, medium: 2, hard: 3 }[difficulty];
---

<Badge tone="neutral" class:list={['gap-1.5', className]}>
  <span aria-hidden="true" class="inline-flex gap-0.5">
    {[1, 2, 3].map((pip) => <span class:list={['size-1.5 rounded-full border border-ink-muted', pip <= filled && 'bg-ink-muted']} />)}
  </span>
  {difficulty}
</Badge>
