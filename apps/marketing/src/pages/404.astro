---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <p class="font-mono text-sm text-ink-muted">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">This page doesn't exist.</h1>
    <p class="mt-3 text-ink-muted">The link may be old, or the address mistyped.</p>
    <div class="mt-8 flex gap-3">
      <Button href="/">Go to the home page</Button>
      <Button variant="secondary" href="/problems">Browse problems</Button>
    </div>
  </div>
</BaseLayout>
