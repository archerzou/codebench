---
/** SEO page per problem: title, track, difficulty, statement excerpt, limits, test counts (pages.md). */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import DifficultyBadge from '../../components/DifficultyBadge.astro';
import TrackBadge from '../../components/TrackBadge.astro';
import Icon from '../../components/Icon.astro';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import { appLink } from '../../config';
import { formatNumber } from '../../lib/format';
import { getProblems, plainExcerpt, type Problem } from '../../lib/problems';

export async function getStaticPaths() {
  const problems = await getProblems();
  return problems.map((problem) => ({ params: { slug: problem.data.slug }, props: { problem } }));
}

type Props = { problem: Problem };
const { problem } = Astro.props;
const { slug, title, track, difficulty, free, tags, limits, visibleTestCount, hiddenTestCount } = problem.data;
const { Content } = await render(problem);
---

<BaseLayout title={title} description={plainExcerpt(problem)}>
  <article class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-muted">
      <a href="/problems" class="hover:text-ink hover:underline">Problems</a>
      <span aria-hidden="true"> / </span>
      <span>{title}</span>
    </nav>

    <div class="mt-4 grid gap-10 lg:grid-cols-[1fr_20rem]">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <TrackBadge track={track} />
          <DifficultyBadge difficulty={difficulty} />
          {free ? <Badge tone="neutral">Free</Badge> : <Badge tone="accent">Pro</Badge>}
        </div>

        <div class="prose-cb mt-6 text-lg">
          <Content />
        </div>
        <p class="mt-4 text-sm text-ink-muted">The full statement, examples and starter code are in the editor.</p>

        {
          tags.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-3" aria-label="Tags">
              {tags.map((tag) => (
                <li class="font-mono text-sm text-ink-muted">#{tag}</li>
              ))}
            </ul>
          )
        }
      </div>

      <aside class="flex flex-col gap-4 self-start rounded-lg border border-line bg-surface-raised p-5">
        <h2 class="text-sm font-semibold">Before you start</h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
          <dt class="text-ink-muted">Time limit</dt>
          <dd class="tabular">{formatNumber(limits.timeoutSeconds)} s per run</dd>
          <dt class="text-ink-muted">Memory</dt>
          <dd class="tabular">{formatNumber(limits.memoryMb)} MB</dd>
          <dt class="text-ink-muted">Examples</dt>
          <dd class="tabular">{visibleTestCount} visible</dd>
          <dt class="text-ink-muted">Hidden tests</dt>
          <dd class="tabular">{hiddenTestCount} on submit</dd>
        </dl>
        <Button href={appLink(`/problems/${slug}`, 'problem-page')} class="w-full">
          Solve in the editor <Icon svg={arrowRight} />
        </Button>
        {
          free ? (
            <p class="text-xs text-ink-muted">Free problem: open it without an account; sign in to submit.</p>
          ) : (
            <p class="text-xs text-ink-muted">Pro problem: needs a Pro plan to open. <a href="/pricing" class="text-accent hover:underline">See pricing</a></p>
          )
        }
      </aside>
    </div>
  </article>
</BaseLayout>
